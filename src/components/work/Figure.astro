---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt?: string;
}

const { src, alt = "" } = Astro.props;
---

<figure>
  <Image src={src} alt={alt} widths={[768, 1280, 2048]} sizes="100vw" />
</figure>

<style>
  figure {
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-card);
  }

  figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
