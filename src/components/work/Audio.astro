---
interface Props {
  src: string;
  title?: string;
}

const { src, title } = Astro.props;
---

<figure>
  {title && <figcaption>{title}</figcaption>}
  <audio src={src} controls></audio>
</figure>

<style>
  figure {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 16px;
    border-radius: var(--radius-card);
    background: var(--color-chip-soft);
  }

  figcaption {
    color: var(--color-ink);
    font-size: var(--type-copy-compact);
    line-height: var(--leading-body);
  }

  audio {
    width: 100%;
  }
</style>
