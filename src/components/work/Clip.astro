---
import LoopVideo from "./LoopVideo.astro";

interface Props {
  src: string;
}

const { src } = Astro.props;
---

<figure>
  <LoopVideo src={src} />
</figure>

<style>
  figure {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-ink);
  }

  figure :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
