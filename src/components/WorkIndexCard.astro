---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import LoopVideo from "./work/LoopVideo.astro";

interface Props {
  href: string;
  title: string;
  image?: ImageMetadata;
  video?: string;
  services: string[];
}

const { href, title, image, video, services } = Astro.props;
---

<a class:list={["work", { plain: !image && !video }]} href={href}>
  {
    video ? (
      <LoopVideo src={video} poster={image?.src} />
    ) : (
      image && <Image src={image} alt="" widths={[768, 1280, 2048]} sizes="100vw" />
    )
  }
  <div class="label">
    <h2>{title}</h2>
    <ul>
      {services.map((service) => <li>{service}</li>)}
    </ul>
  </div>
</a>

<style>
  .work {
    position: relative;
    display: flex;
    height: 100vh;
    overflow: hidden;
    color: var(--color-white);
  }

  .plain {
    background: var(--color-ink);
  }

  .work :global(img),
  .work :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .label {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 20px;
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--type-h2-size);
    font-weight: var(--weight-regular);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-tight);
    text-align: center;
    font-feature-settings: var(--font-feature);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 8px 16px;
    border-radius: var(--radius-chip);
    background: var(--color-chip);
    font-size: var(--type-copy-compact);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-flat);
    backdrop-filter: blur(var(--blur-chip));
  }

</style>
