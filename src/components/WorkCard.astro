---
import { Image } from "astro:assets";
import LoopVideo from "./work/LoopVideo.astro";

interface Props {
  href: string;
  title: string;
  image?: ImageMetadata;
  video?: string;
  span: number;
}

const { href, title, image, video, span } = Astro.props;
---

<a class:list={["work", { plain: !image && !video }]} href={href}>
  {
    video ? (
      <LoopVideo src={video} poster={image?.src} />
    ) : (
      image && <Image src={image} alt="" widths={[768, 1280, 2048]} sizes="100vw" />
    )
  }
  <div class="overlay">
    <div class="mask">
      <div class="marquee-track titles" style={`--ticker-span: ${span}`}>
        <div class="unit">
          <h3>{title}</h3>
          <span aria-hidden="true">•</span>
        </div>
        <div class="unit" aria-hidden="true">
          <h3>{title}</h3>
          <span>•</span>
        </div>
      </div>
    </div>
  </div>
</a>

<style>
  .work {
    position: relative;
    display: block;
    aspect-ratio: 0.8;
    overflow: hidden;
    border-radius: var(--radius-card);
    color: var(--color-white);
  }

  .plain {
    background: var(--color-ink);
  }

  .plain .overlay {
    opacity: 1;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  img,
  .work :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    opacity: 0;
    -webkit-backdrop-filter: blur(var(--blur-overlay));
    backdrop-filter: blur(var(--blur-overlay));
    transition:
      opacity var(--hover-overlay-duration) var(--hover-overlay-ease),
      backdrop-filter var(--hover-overlay-duration) var(--hover-overlay-ease),
      -webkit-backdrop-filter var(--hover-overlay-duration) var(--hover-overlay-ease);
  }

  .work:hover .overlay,
  .work:focus-visible .overlay {
    opacity: 1;
    -webkit-backdrop-filter: blur(var(--blur-hover));
    backdrop-filter: blur(var(--blur-hover));
  }

  @media (min-width: 1200px) and (hover: hover) {
    .work {
      cursor: none;
    }
  }

  .mask {
    width: 100%;
    overflow: hidden;
    mask-image: var(--ticker-mask);
  }

  .titles {
    --marquee-distance: 50%;
    align-items: center;
    animation-duration: calc(var(--ticker-span) / var(--ticker-speed) * 1s);
  }

  .unit {
    display: flex;
    align-items: center;
    gap: 48px;
    padding-right: 48px;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--type-h3-size);
    font-weight: var(--weight-regular);
    line-height: var(--leading-title);
    letter-spacing: var(--tracking-tight);
    white-space: nowrap;
    font-feature-settings: var(--font-feature);
  }

  .unit span {
    font-size: var(--type-h3-size);
    line-height: 1;
  }

  @media (max-width: 809.98px) {
    .work {
      aspect-ratio: 0.75;
    }
  }
</style>
