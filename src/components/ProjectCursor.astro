<div class="project-cursor" data-project-cursor hidden>Open Project</div>

<script>
  const pill = document.querySelector("[data-project-cursor]");
  if (pill instanceof HTMLElement) {
    const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
    const desktop = window.matchMedia("(min-width: 1200px)");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    const stiffness = 500;
    const damping = 60;
    const mass = 1;
    let x = 0;
    let y = 0;
    let vx = 0;
    let vy = 0;
    let tx = 0;
    let ty = 0;
    let running = false;
    let last = 0;
    let over = false;

    const canUse = () => fine.matches && desktop.matches;

    const frame = (now) => {
      const dt = Math.min(0.032, last ? (now - last) / 1000 : 0.016);
      last = now;
      if (reduced.matches) {
        x = tx;
        y = ty;
        vx = 0;
        vy = 0;
      } else {
        vx += ((-stiffness * (x - tx) - damping * vx) / mass) * dt;
        vy += ((-stiffness * (y - ty) - damping * vy) / mass) * dt;
        x += vx * dt;
        y += vy * dt;
      }
      pill.style.transform = `translate(-50%, -100%) translate(${x}px, ${y}px)`;
      const settled = Math.hypot(x - tx, y - ty) < 0.2 && Math.hypot(vx, vy) < 0.2;
      if (!over && settled) {
        running = false;
        return;
      }
      requestAnimationFrame(frame);
    };

    const start = () => {
      if (running) return;
      running = true;
      last = 0;
      requestAnimationFrame(frame);
    };

    const hide = () => {
      over = false;
      pill.hidden = true;
    };

    window.addEventListener(
      "pointermove",
      (event) => {
        if (!canUse() || event.pointerType === "touch") {
          hide();
          return;
        }
        const target = event.target;
        const card = target instanceof Element ? target.closest("a.work") : null;
        if (!card) {
          hide();
          return;
        }
        tx = event.clientX + 20;
        ty = event.clientY - 20;
        if (!over) {
          x = tx;
          y = ty;
          vx = 0;
          vy = 0;
          over = true;
          pill.hidden = false;
        }
        start();
      },
      { passive: true },
    );

    fine.addEventListener("change", hide);
    desktop.addEventListener("change", hide);
  }
</script>

<style>
  .project-cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 13;
    display: flex;
    align-items: center;
    justify-content: center;
    width: max-content;
    margin: 0;
    padding: 6px 12px;
    border-radius: 50px;
    background: rgba(0, 0, 0, 0.2);
    -webkit-backdrop-filter: blur(var(--blur-nav));
    backdrop-filter: blur(var(--blur-nav));
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: var(--weight-regular);
    line-height: 1.4;
    letter-spacing: -0.04em;
    white-space: nowrap;
    font-feature-settings: var(--font-feature);
    pointer-events: none;
  }

  .project-cursor[hidden] {
    display: none;
  }
</style>
