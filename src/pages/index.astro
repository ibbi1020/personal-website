---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import WorkCard from "../components/WorkCard.astro";
import ProjectCursor from "../components/ProjectCursor.astro";
import portrait from "../assets/works/portrait.png";
import { getWorks } from "../lib/works";

const works = (await getWorks()).filter((work) => work.data.featured);

const experience: { title: string; place: string; href?: string; note?: string }[] = [
  { title: "Solo founder", place: "Notch", href: "/works/notch" },
  {
    title: "RL Environment Engineer",
    place: "Fleet AI",
    href: "https://www.fleetai.com",
    note: "Backed by Sequoia and Menlo Ventures",
  },
  { title: "Product Manager", place: "Antematter", href: "https://antematter.io" },
  { title: "Principal Designer", place: "Antematter", href: "https://antematter.io" },
];

const upcoming = [
  { name: "ChatVibe", href: "/works/chatvibe" },
  { name: "Orator", href: "/works/orator" },
];
const line = "A product engineer with taste.".split(" ");
---

<Base>
  <main>
    <section class="hero">
      <div class="hero-frame">
        <Nav />
        <div class="hero-parallax">
          <div class="ticker">
            <h1>
              {
                line.map((word, index) => (
                  <span class="rise-word" style={`--word: ${index}`}>{word}</span>
                ))
              }
            </h1>
          </div>
          <h1 class="name">
            <span class="rise-name line">Ibraheem</span>
            <span class="rise-name line">
              <span class="accent">Farooq</span>.
            </span>
          </h1>
        </div>
      </div>
    </section>

    <section class="works" aria-label="Selected works">
      <div class="grid">
        {works.map((work) => (
          <WorkCard
            href={`/works/${work.id}`}
            title={work.data.title}
            image={work.data.cover}
            video={work.data.video}
            span={work.data.span ?? 240}
          />
        ))}
      </div>
      <a class="all" href="/works">
        <span>See all Works</span>
        <svg viewBox="0 0 256 256" aria-hidden="true">
          <path
            d="M224.49,136.49l-72,72a12,12,0,0,1-17-17L187,140H40a12,12,0,0,1,0-24H187L135.51,64.48a12,12,0,0,1,17-17l72,72A12,12,0,0,1,224.49,136.49Z"
          ></path>
        </svg>
      </a>
    </section>

    <section class="about" id="about">
      <div class="about-copy">
        <div class="details">
          <div class="block">
            <h2>About me</h2>
            <p>
              Taste is part of the build. A product that works and feels careless is unfinished. I
              like design engineering because the person who decides how it feels should be able to
              make it.
            </p>
            <p>
              I work in small teams and stay close to the user. I ship a thin version and iterate. I
              have taken products from zero to one, and I have managed when the work needed a team.
            </p>
          </div>
          <div class="block">
            <h2>Experience</h2>
            <div class="roles">
              {
                experience.map((role) => (
                  <div class="role-group">
                    <p class="role">{role.title}</p>
                    <p class="role">
                      {
                        role.href ? (
                          <a
                            href={role.href}
                            target={role.href.startsWith("http") ? "_blank" : undefined}
                            rel={role.href.startsWith("http") ? "noopener" : undefined}
                          >
                            @{role.place}
                          </a>
                        ) : (
                          <span>@{role.place}</span>
                        )
                      }
                      {role.note && <span class="role-note">({role.note})</span>}
                    </p>
                  </div>
                ))
              }
              {
                upcoming.map((item) => (
                  <p class="role">
                    <a href={item.href}>{item.name}</a>
                  </p>
                ))
              }
            </div>
          </div>
        </div>
      </div>
      <div class="portrait">
        <img src={portrait.src} width={portrait.width} height={portrait.height} alt="" />
      </div>
    </section>
  </main>

  <Footer />
  <ProjectCursor />
</Base>

<style>
  .hero {
    display: flex;
    width: 100%;
    height: 100vh;
  }

  .hero-frame {
    display: flex;
    flex: 1;
    flex-direction: column;
    width: 100%;
    min-width: 0;
    min-height: 0;
    margin: 0;
    overflow: hidden;
    border-radius: 0;
    background: var(--color-ink);
    color: var(--color-canvas);
    animation: hero-settle var(--duration-rise) var(--ease-out) var(--delay-name) both;
  }

  .hero-parallax {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    min-height: 0;
  }

  @keyframes hero-settle {
    from {
      margin: 0;
      border-radius: 0;
    }
    to {
      margin: var(--pad-hero);
      border-radius: var(--radius-card);
    }
  }

  .ticker {
    display: flex;
    align-items: center;
    width: 100%;
    padding: max(12px, calc(var(--nav-top) * 100vh - var(--pad-hero) - 16px)) 24px 0;
  }

  .ticker h1 {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25em;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--type-ticker-size);
    font-weight: var(--weight-light);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-tight);
    font-feature-settings: var(--font-feature);
  }

  .ticker .rise-word {
    --rise: var(--rise-line);
    animation-duration: var(--duration-line);
    animation-timing-function: var(--ease-out);
    animation-delay: calc(
      var(--delay-name) + var(--delay-line) + var(--word, 0) *
        var(--delay-line-step)
    );
  }

  .name {
    width: 100%;
    margin: 0;
    padding: var(--pad-name);
    font-family: var(--font-display);
    font-size: var(--type-name-size);
    font-weight: var(--weight-regular);
    line-height: var(--leading-name);
    letter-spacing: var(--tracking-name);
    text-align: right;
    font-feature-settings: var(--font-feature);
  }

  .line {
    display: block;
  }

  .accent {
    color: var(--color-name-accent);
  }

  .works {
    position: relative;
    padding: 0 var(--pad-hero);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(50px, 1fr));
    gap: var(--pad-hero);
  }

  .all {
    position: absolute;
    z-index: 5;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 26px;
    border-radius: var(--radius-button);
    background: var(--color-button);
    color: var(--color-black);
    font-family: var(--font-display);
    font-size: var(--type-copy-compact);
    font-weight: var(--type-button-weight);
    line-height: var(--leading-button);
    letter-spacing: var(--tracking-button);
    white-space: nowrap;
    transform: translate(-50%, -50%);
    font-feature-settings: var(--font-feature);
  }

  .all svg {
    position: absolute;
    right: -23px;
    bottom: 14px;
    width: 22px;
    height: 19px;
    fill: var(--color-button);
  }

  .about {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 8px 0 0;
  }

  .about-copy {
    flex: 1;
    min-width: 0;
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: 72px;
    padding: 48px 16px;
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 720px;
  }

  .about h2 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--type-h2-size);
    font-weight: var(--weight-regular);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-tight);
    font-feature-settings: var(--font-feature);
  }

  .about p {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--type-copy-compact);
    font-weight: var(--weight-regular);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-flat);
    font-feature-settings: var(--font-feature);
  }

  .roles {
    display: flex;
    flex-direction: column;
    gap: 1.4em;
    font-size: var(--type-lead-size);
  }

  .about .role {
    font-size: var(--type-lead-size);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-tight);
    font-feature-settings: var(--font-feature-body);
  }

  .role a {
    text-decoration: underline;
  }

  .role a:hover,
  .role a:focus-visible {
    color: var(--color-muted);
    text-underline-offset: 3px;
  }

  .about .role-note {
    margin-left: 0.4em;
    color: var(--color-muted);
    font-size: var(--type-copy-compact);
    letter-spacing: var(--tracking-flat);
  }

  .portrait {
    position: sticky;
    top: 8px;
    flex: 1;
    min-width: 0;
    aspect-ratio: 0.75;
    padding: 0 8px;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    border-radius: var(--radius-card);
  }

  @media (max-width: 1199.98px) {
    .ticker {
      display: none;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .all {
      top: auto;
      bottom: 22px;
      transform: translateX(-50%);
    }

    .about {
      flex-direction: column;
    }

    .portrait {
      position: relative;
      top: auto;
      width: 100%;
    }
  }

  @media (max-width: 809.98px) {
    .all {
      bottom: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-frame {
      animation: none;
      margin: var(--pad-hero);
      border-radius: var(--radius-card);
    }
  }
</style>

<script>
  const hero = document.querySelector(".hero");
  const layer = document.querySelector(".hero-parallax");
  const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const lag = 0.42;

  const render = () => {
    if (!hero || !layer) return;
    if (motion.matches) {
      layer.style.transform = "";
      return;
    }
    const rect = hero.getBoundingClientRect();
    const traveled = Math.min(Math.max(-rect.top, 0), rect.height);
    layer.style.transform = `translate3d(0, ${traveled * lag}px, 0)`;
  };

  let frame = 0;
  const onScroll = () => {
    if (frame) return;
    frame = requestAnimationFrame(() => {
      frame = 0;
      render();
    });
  };

  render();
  window.addEventListener("scroll", onScroll, { passive: true });
  motion.addEventListener("change", render);
</script>
