---
import Base from "../layouts/Base.astro";
import Frame from "../components/Frame.astro";
---

<Base>
  <Frame noise>
    <h1>
      <span class="muted">Error 404</span>
      <span>Page not found</span>
    </h1>
    <a class="back" href="/">
      <span class="back-track">
        <span>Go to the homepage</span>
        <span class="back-tilt" aria-hidden="true">Go to the homepage</span>
      </span>
    </a>
  </Frame>
</Base>

<style>
  h1 {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--type-project-size);
    font-weight: var(--weight-regular);
    line-height: var(--leading-title);
    letter-spacing: var(--tracking-tight);
    text-align: center;
    font-feature-settings: var(--font-feature);
  }

  .muted {
    color: var(--color-muted);
  }

  .back {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--pad-return);
    overflow: hidden;
    border-radius: var(--radius-return);
    background: var(--color-white);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--type-copy-size);
    font-weight: var(--weight-regular);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-flat);
    font-feature-settings: var(--font-feature);
  }

  .back-track {
    display: flex;
    flex-direction: column;
    gap: var(--return-gap);
    height: var(--leading-body);
    overflow: hidden;
  }

  .back-tilt {
    transform: rotate(var(--return-tilt));
  }

  .back:hover .back-track,
  .back:focus-visible .back-track {
    justify-content: flex-end;
  }
</style>
